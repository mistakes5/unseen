# Dev convenience only. End users should store keys via Settings → Providers
# (saved in the OS keychain through Electron safeStorage). Never commit .env.
DEEPGRAM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
TYPESAFE_API_KEY=
OPENAI_COMPATIBLE_API_KEY=

