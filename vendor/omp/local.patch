@@ -0,0 +1,58 @@
+import { expect, test } from "bun:test";
+import * as path from "node:path";
+import { type } from "@oh-my-pi/omptype";
+import { AuthStorage, type Context } from "@oh-my-pi/pi-ai";
+import { TempDir } from "@oh-my-pi/pi-utils";
+import { ModelRegistry } from "../../src/config/model-registry";
+import { ModelsConfigSchema } from "../../src/config/models-config-schema";
+import { assertProviderContextImageBudget } from "../../src/session/provider-image-budget";
+
+test("a deployment image cap from models.yml controls requests and rejects a fractional cap", async () => {
+	const model = { id: "glm", input: ["text", "image"], contextWindow: 262144, maxTokens: 4096, maxInputImages: 7 };
+	const config = {
+		providers: {
+			"private-deployment": {
+				api: "openai-completions",
+				baseUrl: "https://invalid.test/v1",
+				auth: "none",
+				models: [model],
+			},
+		},
+	};
+	const invalid = ModelsConfigSchema({
+		providers: {
+			"private-deployment": {
+				...config.providers["private-deployment"],
+				models: [{ ...model, maxInputImages: 2.5 }],
+			},
+		},
+	});
+	expect(invalid instanceof type.errors).toBe(true);
+	const dir = TempDir.createSync("omp-image-cap-config-");
+	const auth = await AuthStorage.create(":memory:");
+	try {
+		const filename = path.join(dir.path(), "models.yml");
+		await Bun.write(filename, JSON.stringify(config));
+		const registry = new ModelRegistry(auth, filename);
+		const resolved = registry.find("private-deployment", "glm");
+		if (!resolved) throw new Error(String(registry.getError() ?? "Custom model did not load"));
+		const context: Context = {
+			systemPrompt: [],
+			messages: [
+				{
+					role: "user",
+					content: Array.from({ length: 8 }, (_, i) => ({
+						type: "image",
+						data: `photo-${i}`,
+						mimeType: "image/png",
+					})),
+					timestamp: 0,
+				},
+			],
+		};
+		expect(() => assertProviderContextImageBudget(context, resolved)).toThrow("deployment cap 7");
+	} finally {
+		auth.close();
+		dir.removeSync();
+	}
+});
diff --git a/packages/coding-agent/test/prefill-diagnostics.test.ts b/packages/coding-agent/test/prefill-diagnostics.test.ts
new file mode 100644
index 0000000..30d523d
--- /dev/null
+++ b/packages/coding-agent/test/prefill-diagnostics.test.ts
@@ -0,0 +1,59 @@
+import { expect, test } from "bun:test";
+import { buildModel } from "@oh-my-pi/pi-catalog/build";
+import { streamOpenAICompletions } from "@oh-my-pi/pi-ai/providers/openai-completions";
+import { limitOutput, summarizePayload } from "../examples/extensions/prefill-diagnostics";
+
+test("diagnostics distinguish an appended request from a rewritten earlier image without recording contents", () => {
+	const first = {
+		messages: [{ role: "user", content: [{ type: "image_url", image_url: { url: "secret-image-data" } }] }],
+		tools: [{ name: "read" }],
+	};
+	const initial = summarizePayload(first);
+	const appended = { ...first, messages: [...first.messages, { role: "user", content: [] }] };
+	expect(summarizePayload(appended, initial.hashes).commonMessages).toBe(1);
+	const evicted = { ...appended, messages: [{ role: "user", content: [] }, appended.messages[1]] };
+	expect(summarizePayload(evicted, initial.hashes).commonMessages).toBe(0);
+	expect(initial.images).toBe(1);
+	expect(JSON.stringify(initial)).not.toContain("secret-image-data");
+});
+
+test("bounded review output cap wins without mutating the provider payload or raising smaller caps", () => {
+	const original = { max_tokens: 131072, messages: [], credentials: "private" };
+	expect(limitOutput(original, 8192)).toMatchObject({ max_tokens: 8192 });
+	expect(original.max_tokens).toBe(131072);
+	expect(limitOutput({ max_output_tokens: 512 }, 8192)).toMatchObject({ max_output_tokens: 512 });
+});
+
+test("aborting from the request budget hook stops transport before any HTTP attempt", async () => {
+	const model = buildModel({
+		id: "glm",
+		name: "Offline fixture",
+		api: "openai-completions",
+		provider: "offline-test",
+		baseUrl: "https://invalid.test/v1",
+		reasoning: false,
+		input: ["text"],
+		contextWindow: 4096,
+		maxTokens: 1024,
+		cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+	});
+	const controller = new AbortController();
+	let httpAttempts = 0;
+	const result = await streamOpenAICompletions(
+		model,
+		{ systemPrompt: [], messages: [{ role: "user", content: "offline budget fixture", timestamp: 0 }] },
+		{
+			apiKey: "offline-test-key",
+			signal: controller.signal,
+			onPayload: () => {
+				controller.abort();
+			},
+			fetch: () => {
+				httpAttempts++;
+				return Promise.reject(new Error("HTTP forbidden in offline test"));
+			},
+		},
+	).result();
+	expect(result.stopReason).toBe("aborted");
+	expect(httpAttempts).toBe(0);
+});
