+/** Request metadata only: no prompts, image bytes, headers, URLs, or credentials. */
+import * as fs from "node:fs/promises";
+import * as path from "node:path";
+import { getAgentDir, logger, type ExtensionAPI, type ExtensionContext } from "@oh-my-pi/pi-coding-agent";
+import { isRecord } from "@oh-my-pi/pi-utils";
+
+function digest(value: unknown): string {
+	return new Bun.CryptoHasher("sha256").update(JSON.stringify(value) ?? "null").digest("hex");
+}
+
+function images(value: unknown): number {
+	if (Array.isArray(value)) return value.reduce((sum: number, part: unknown) => sum + images(part), 0);
+	if (!isRecord(value)) return 0;
+	if (value.type === "image" || value.type === "input_image" || value.type === "image_url") return 1;
+	return Object.values(value).reduce((sum: number, part: unknown) => sum + images(part), 0);
+}
+
+export function summarizePayload(payload: unknown, previous: readonly string[] = []) {
+	const body = isRecord(payload) ? payload : {};
+	const messages = Array.isArray(body.messages)
+		? body.messages
+		: Array.isArray(body.input)
+			? body.input
+			: Array.isArray(body.contents)
+				? body.contents
+				: [];
+	const hashes = messages.map(digest);
+	let commonMessages = 0;
+	while (
+		commonMessages < Math.min(hashes.length, previous.length) &&
+		hashes[commonMessages] === previous[commonMessages]
+	)
+		commonMessages++;
+	return {
+		hashes,
+		commonMessages,
+		previousMessages: previous.length,
+		messageCount: hashes.length,
+		images: images(messages),
+		bytes: Buffer.byteLength(JSON.stringify(payload) ?? "null"),
+		outputLimit: [body.max_tokens, body.max_completion_tokens, body.max_output_tokens].find(
+			value => typeof value === "number",
+		),
+		fixedHash: digest({
+			system: body.system,
+			instructions: body.instructions,
+			tools: body.tools,
+			tool_choice: body.tool_choice,
+		}),
+	};
+}
+
+/** Opt-in worker budget, set by bounded_native_review.py; ordinary sessions only log. */
+export function limitOutput(payload: unknown, limit: number): unknown {
+	if (!isRecord(payload) || limit <= 0) return payload;
+	const body = { ...payload };
+	for (const key of ["max_tokens", "max_completion_tokens", "max_output_tokens"]) {
+		if (typeof body[key] === "number") body[key] = Math.min(body[key], limit);
+	}
+	return body;
+}
+
+function budget(name: string): number {
+	const value = Number(process.env[name] ?? 0);
+	if (!Number.isSafeInteger(value) || value < 0) throw new Error(`${name} must be a non-negative integer`);
+	return value;
+}
+
+export default function prefillDiagnostics(pi: ExtensionAPI) {
+	let sessionId = "";
+	let previous: string[] = [];
+	let requests = 0;
+	let uncachedInput = 0;
+	let beganAt = Date.now();
+	let boundary = 0;
+	let requestStartedAt: number | undefined;
+	let firstDeltaSeen = false;
+	let compacting = false;
+	let pending: Promise<void> = Promise.resolve();
+	const maxRequests = budget("OMP_REVIEW_MAX_REQUESTS");
+	const maxSeconds = budget("OMP_REVIEW_MAX_SECONDS");
+	const maxInput = budget("OMP_REVIEW_MAX_UNCACHED_INPUT");
+	const maxOutput = budget("OMP_REVIEW_MAX_OUTPUT");
+
+	function record(ctx: ExtensionContext, event: Record<string, unknown>): Promise<void> {
+		const id = ctx.sessionManager.getSessionId();
+		if (sessionId !== id) {
+			sessionId = id;
+			previous = [];
+			requests = 0;
+			uncachedInput = 0;
+			boundary = 0;
+			beganAt = Date.now();
+		}
+		const line = JSON.stringify({ version: 1, at: new Date().toISOString(), sessionId: id, boundary, ...event });
+		const filename = path.join(getAgentDir(), "diagnostics", "prefill", `${id}.jsonl`);
+		pending = pending
+			.then(async () => {
+				await fs.mkdir(path.dirname(filename), { recursive: true, mode: 0o700 });
+				await fs.appendFile(filename, `${line}\n`, { mode: 0o600 });
+			})
+			.catch(error => logger.warn("Prefill diagnostics write failed", { error: String(error) }));
+		return pending;
+	}
+
+	pi.on("session_start", async (_event, ctx) => {
+		await record(ctx, { event: "session_start" });
+	});
+	pi.on("before_provider_request", async (event, ctx) => {
+		if (
+			(maxRequests > 0 && requests >= maxRequests) ||
+			(maxSeconds > 0 && Date.now() - beganAt >= maxSeconds * 1000) ||
+			(maxInput > 0 && uncachedInput >= maxInput)
+		) {
+			await record(ctx, { event: "worker_budget_stop", requests, uncachedInput });
+			ctx.abort();
+			throw new Error("Bounded review budget exhausted; durable progress must be checked before restarting.");
+		}
+		const payload = limitOutput(event.payload, maxOutput);
+		const summary = summarizePayload(payload, compacting ? [] : previous);
+		if (!compacting) previous = summary.hashes;
+		requests++;
+		requestStartedAt = performance.now();
+		firstDeltaSeen = false;
+		await record(ctx, {
+			event: "request",
+			request: requests,
+			kind: compacting ? "compaction" : "agent",
+			provider: ctx.model?.provider,
+			model: ctx.model?.id,
+			...summary,
+		});
+		return payload;
+	});
+	pi.on("after_provider_response", async (event, ctx) => {
+		await record(ctx, {
+			event: "response_headers",
+			request: requests,
+			status: event.status,
+			serverRequestId: event.requestId,
+			headersAfterMs: requestStartedAt === undefined ? undefined : performance.now() - requestStartedAt,
+		});
+		// A bounded worker cannot make useful progress with forbidden credentials.
+		if (maxRequests > 0 && (event.status === 401 || event.status === 403)) ctx.abort();
+	});
+	pi.on("message_update", async (event, ctx) => {
+		const update = event.assistantMessageEvent;
+		if (
+			firstDeltaSeen ||
+			requestStartedAt === undefined ||
+			(update.type !== "text_delta" && update.type !== "thinking_delta" && update.type !== "toolcall_delta") ||
+			!update.delta
+		)
+			return;
+		firstDeltaSeen = true;
+		await record(ctx, {
+			event: "first_delta",
+			request: requests,
+			kind: update.type,
+			firstDeltaAfterMs: performance.now() - requestStartedAt,
+		});
+	});
+	pi.on("message_end", async (event, ctx) => {
+		if (event.message.role !== "assistant") return;
+		const { usage, stopReason, errorId, responseId } = event.message;
+		if (
+			maxRequests > 0 &&
+			stopReason === "error" &&
+			/key_disabled|invalid_api_key|authentication_error/i.test(event.message.errorMessage ?? "")
+		)
+			ctx.abort();
+		uncachedInput += usage.input;
+		await record(ctx, {
+			event: "assistant_end",
+			request: requests,
+			stopReason,
+			errorId,
+			responseId,
+			durationMs: requestStartedAt === undefined ? undefined : performance.now() - requestStartedAt,
+			usage: { input: usage.input, cacheRead: usage.cacheRead, cacheWrite: usage.cacheWrite, output: usage.output },
+			uncachedInput,
+		});
+	});
+	pi.on("session_compact", async (_event, ctx) => {
+		boundary++;
+		await record(ctx, { event: "compaction_commit" });
+	});
+	pi.on("compaction_request_end", async (event, ctx) => {
+		uncachedInput += event.usage.input;
+		await record(ctx, {
+			event: "compaction_request_end",
+			request: event.responseId ? requests : undefined,
+			provider: event.provider,
+			model: event.model,
+			responseId: event.responseId,
+			stopReason: event.stopReason,
+			usage: {
+				input: event.usage.input,
+				cacheRead: event.usage.cacheRead,
+				cacheWrite: event.usage.cacheWrite,
+				output: event.usage.output,
+			},
+			uncachedInput,
+		});
+	});
+	pi.on("auto_compaction_start", async (event, ctx) => {
+		compacting = true;
+		await record(ctx, { event: "compaction_start", reason: event.reason, action: event.action });
+	});
+	pi.on("auto_compaction_end", async (event, ctx) => {
+		compacting = false;
+		await record(ctx, { event: "compaction_end", aborted: event.aborted, action: event.action });
+	});
+	pi.on("session_shutdown", async () => {
+		await pending;
+	});
+}
